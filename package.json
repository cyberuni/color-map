{
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"clean": "turbo run clean",
		"cm": "pnpm --filter color-map",
		"coverage": "turbo run coverage",
		"cs": "changeset",
		"depcheck": "turbo run depcheck",
		"format": "biome format . --write",
		"lint": "biome lint .",
		"nuke": "turbo run nuke && pnpm nuke:local",
		"nuke:local": "rimraf node_modules",
		"plugin:build": "universal-plugin plugin build --root packages/color-map",
		"plugin:check": "universal-plugin plugin build --check --root packages/color-map",
		"plugin:check-version": "universal-plugin publish check-version --root packages/color-map",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "run-p lint verify:pkg plugin:check plugin:check-version",
		"verify:pkg": "turbo run build coverage depcheck typecheck llms:check size pack:check",
		"version": "changeset version && pnpm --filter color-map exec node scripts/sync-plugin-version.mjs && universal-plugin plugin version --from-package --root packages/color-map",
		"watch": "turbo run watch",
		"web": "pnpm --filter=website"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"npm-run-all2": "^9.0.3",
		"rimraf": "^6.1.3",
		"turbo": "^2.10.9",
		"universal-plugin": "0.23.0"
	},
	"packageManager": "pnpm@12.22.0"
}
