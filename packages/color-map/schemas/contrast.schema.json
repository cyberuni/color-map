{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://unpkg.com/color-map/schemas/contrast.schema.json",
	"title": "color-map contrast",
	"description": "WCAG 2 contrast ratio of a text color on a background, with the AA and AAA verdicts",
	"type": "object",
	"properties": {
		"fg": {
			"type": "string",
			"description": "The text (foreground) color",
			"x-kind": "argument"
		},
		"bg": {
			"type": "string",
			"description": "The background color",
			"x-kind": "argument"
		}
	},
	"required": [
		"fg",
		"bg"
	],
	"additionalProperties": false
}
