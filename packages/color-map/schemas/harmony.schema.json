{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://unpkg.com/color-map/schemas/harmony.schema.json",
	"title": "color-map harmony",
	"description": "The colors of a harmony scheme: the color rotated around the hue wheel",
	"type": "object",
	"properties": {
		"color": {
			"type": "string",
			"description": "The base color",
			"x-kind": "argument"
		},
		"scheme": {
			"type": "string",
			"enum": [
				"complementary",
				"split",
				"analogous",
				"triadic",
				"tetradic"
			],
			"description": "The harmony scheme",
			"default": "complementary",
			"x-kind": "option"
		},
		"space": {
			"type": "string",
			"enum": [
				"hsl",
				"hwb",
				"lch",
				"oklch"
			],
			"description": "The space whose hue is rotated",
			"default": "oklch",
			"x-kind": "option"
		},
		"gamut": {
			"type": "string",
			"enum": [
				"srgb",
				"srgb-linear",
				"display-p3",
				"display-p3-linear",
				"a98-rgb",
				"prophoto-rgb",
				"rec2020"
			],
			"description": "The gamut every color must fit",
			"default": "srgb",
			"x-kind": "option"
		}
	},
	"required": [
		"color"
	],
	"additionalProperties": false
}
