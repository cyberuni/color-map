{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://unpkg.com/color-map/schemas/convert.schema.json",
	"title": "color-map convert",
	"description": "Convert a CSS color to another color space",
	"type": "object",
	"properties": {
		"color": {
			"type": "string",
			"description": "Any CSS color, such as \"#3b82f6\" or \"oklch(0.7 0.15 250)\"",
			"x-kind": "argument"
		},
		"to": {
			"type": "string",
			"enum": [
				"srgb",
				"srgb-linear",
				"hsl",
				"hwb",
				"lab",
				"lch",
				"oklab",
				"oklch",
				"display-p3",
				"display-p3-linear",
				"a98-rgb",
				"prophoto-rgb",
				"rec2020",
				"xyz-d50",
				"xyz-d65"
			],
			"description": "Target color space",
			"default": "srgb",
			"x-kind": "option"
		},
		"gamut": {
			"type": "string",
			"enum": [
				"srgb",
				"srgb-linear",
				"display-p3",
				"display-p3-linear",
				"a98-rgb",
				"prophoto-rgb",
				"rec2020"
			],
			"description": "Map the result into this gamut (CSS gamut mapping) when it falls outside",
			"x-kind": "option"
		},
		"full": {
			"type": "boolean",
			"description": "Show the complete output instead of truncating it",
			"x-kind": "option"
		}
	},
	"required": [
		"color"
	],
	"additionalProperties": false
}
