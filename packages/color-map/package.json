{
	"name": "color-map",
	"version": "2.2.0",
	"description": "Color map generator and color toolkit: a library, a CLI and an agent skill",
	"homepage": "https://github.com/cyberuni/color-map",
	"bugs": {
		"url": "https://github.com/cyberuni/color-map/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/color-map.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./esm/index.d.ts",
			"import": "./esm/index.js",
			"require": "./cjs/index.js",
			"default": "./cjs/index.js"
		},
		"./color": {
			"types": "./esm/color/index.d.ts",
			"import": "./esm/color/index.js",
			"require": "./cjs/color/index.js",
			"default": "./cjs/color/index.js"
		},
		"./export": {
			"types": "./esm/export/index.d.ts",
			"import": "./esm/export/index.js",
			"require": "./cjs/export/index.js",
			"default": "./cjs/export/index.js"
		},
		"./palette": {
			"types": "./esm/palette/index.d.ts",
			"import": "./esm/palette/index.js",
			"require": "./cjs/palette/index.js",
			"default": "./cjs/palette/index.js"
		},
		"./scale": {
			"types": "./esm/scale/index.d.ts",
			"import": "./esm/scale/index.js",
			"require": "./cjs/scale/index.js",
			"default": "./cjs/scale/index.js"
		},
		"./schemas/*": "./schemas/*",
		"./package.json": "./package.json"
	},
	"main": "./cjs/index.js",
	"types": "./esm/index.d.ts",
	"files": [
		"bin",
		"cjs",
		"dist",
		"esm",
		"schemas",
		"skills",
		"src",
		"llms.txt",
		"plugin.json",
		".claude-plugin",
		".codex-plugin",
		".cursor-plugin",
		"!**/*.spec.*",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsdown && node scripts/write-schemas.mjs",
		"bench": "node scripts/bench.mjs",
		"build:watch": "tsdown --watch",
		"clean": "rimraf .reports bin cjs coverage dist esm",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"llms": "node scripts/generate-llms-txt.mjs",
		"llms:check": "node scripts/generate-llms-txt.mjs --check",
		"nuke": "pnpm clean && rimraf node_modules",
		"pack:check": "node scripts/check-pack.mjs && node scripts/sync-plugin-version.mjs --check",
		"schemas": "node scripts/write-schemas.mjs",
		"size": "size-limit",
		"test": "vitest run",
		"typecheck": "tsc",
		"verify": "npm-run-all build -p depcheck typecheck coverage size llms:check pack:check",
		"watch": "vitest"
	},
	"devDependencies": {
		"@size-limit/preset-small-lib": "^14.3.0",
		"@types/culori": "^4.0.1",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^5.0.0",
		"assertron": "^11.0.0",
		"clibuilder": "~12.1.0",
		"colorjs.io": "0.7.1",
		"culori": "4.0.2",
		"depcheck": "^1.4.3",
		"npm-run-all2": "^9.0.3",
		"rimraf": "^6.1.3",
		"size-limit": "^14.3.0",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">= 20.19"
	},
	"size-limit": [
		{
			"name": "existing API",
			"path": "esm/index.js",
			"import": "{ createColors, createColorsFromMap, rgbHex, rgbaString }",
			"limit": "0.45 kB",
			"gzip": true
		},
		{
			"name": "convert between two spaces",
			"path": "esm/color/index.js",
			"import": "{ createConverter, srgb, oklch }",
			"limit": "1.2 kB",
			"gzip": true
		},
		{
			"name": "full color core",
			"path": "esm/color/index.js",
			"import": "{ parse, toCss, toHex, toGamut, inGamut, deltaEOK, equals, fromArgb, toArgb, convert, spaces }",
			"limit": "6.6 kB",
			"gzip": true
		},
		{
			"name": "core with mix",
			"path": "esm/color/index.js",
			"import": "{ parse, toCss, toGamut, mix }",
			"limit": "6.85 kB",
			"gzip": true
		},
		{
			"name": "core with mix and contrast",
			"path": "esm/color/index.js",
			"import": "{ parse, toCss, toGamut, mix, contrast, meets, onColor, findContrast }",
			"limit": "7.5 kB",
			"gzip": true
		},
		{
			"name": "scales",
			"path": "esm/scale/index.js",
			"import": "*",
			"limit": "8 kB",
			"gzip": true
		},
		{
			"name": "palette",
			"path": "esm/palette/index.js",
			"import": "*",
			"limit": "8.3 kB",
			"gzip": true
		},
		{
			"name": "export",
			"path": "esm/export/index.js",
			"import": "*",
			"limit": "7.45 kB",
			"gzip": true
		},
		{
			"name": "everything",
			"path": "esm/color/index.js",
			"import": "*",
			"limit": "10.2 kB",
			"gzip": true
		}
	],
	"keywords": [
		"agent",
		"axi",
		"cli",
		"color",
		"design-system",
		"palette"
	],
	"bin": {
		"color-map": "./bin/color-map.js"
	}
}
