{
	"name": "color-map",
	"version": "2.2.0",
	"description": "Color map generator",
	"homepage": "https://github.com/cyberuni/color-map",
	"bugs": {
		"url": "https://github.com/cyberuni/color-map/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/color-map.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./esm/index.d.ts",
			"import": "./esm/index.js",
			"require": "./cjs/index.js",
			"default": "./cjs/index.js"
		},
		"./color": {
			"types": "./esm/color/index.d.ts",
			"import": "./esm/color/index.js",
			"require": "./cjs/color/index.js",
			"default": "./cjs/color/index.js"
		},
		"./scale": {
			"types": "./esm/scale/index.d.ts",
			"import": "./esm/scale/index.js",
			"require": "./cjs/scale/index.js",
			"default": "./cjs/scale/index.js"
		}
	},
	"main": "./cjs/index.js",
	"types": "./esm/index.d.ts",
	"files": [
		"cjs",
		"dist",
		"esm",
		"src",
		"!**/*.spec.*",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"clean": "rimraf .reports cjs coverage dist esm",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "pnpm clean && rimraf node_modules",
		"test": "vitest run",
		"typecheck": "tsc",
		"verify": "npm-run-all build -p depcheck typecheck coverage size",
		"watch": "vitest",
		"size": "size-limit"
	},
	"devDependencies": {
		"@size-limit/preset-small-lib": "^14.3.0",
		"@types/culori": "^4.0.1",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^5.0.0",
		"assertron": "^11.0.0",
		"colorjs.io": "0.7.1",
		"culori": "4.0.2",
		"depcheck": "^1.4.3",
		"npm-run-all2": "^9.0.3",
		"rimraf": "^6.1.3",
		"size-limit": "^14.3.0",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">= 20"
	},
	"size-limit": [
		{
			"name": "existing API",
			"path": "esm/index.js",
			"import": "{ createColors, createColorsFromMap, rgbHex, rgbaString }",
			"limit": "0.6 kB",
			"gzip": true
		},
		{
			"name": "convert between two spaces",
			"path": "esm/color/index.js",
			"import": "{ createConverter, srgb, oklch }",
			"limit": "2 kB",
			"gzip": true
		},
		{
			"name": "full color core",
			"path": "esm/color/index.js",
			"import": "{ parse, toCss, toHex, toGamut, inGamut, deltaEOK, equals, fromArgb, toArgb, convert, spaces }",
			"limit": "10 kB",
			"gzip": true
		},
		{
			"name": "core with mix",
			"path": "esm/color/index.js",
			"import": "{ parse, toCss, toGamut, mix }",
			"limit": "12 kB",
			"gzip": true
		},
		{
			"name": "core with mix and contrast",
			"path": "esm/color/index.js",
			"import": "{ parse, toCss, toGamut, mix, contrast, meets, onColor, findContrast }",
			"limit": "12 kB",
			"gzip": true
		},
		{
			"name": "scales",
			"path": "esm/scale/index.js",
			"import": "*",
			"limit": "9 kB",
			"gzip": true
		},
		{
			"name": "everything",
			"path": "esm/color/index.js",
			"import": "*",
			"limit": "18 kB",
			"gzip": true
		}
	]
}
