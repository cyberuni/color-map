.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directory
jspm_packages
node_modules

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# webstorm
.idea

# build output — unanchored so it matches inside packages/*, not just the repo root.
# Anchored patterns (/cjs) silently stopped matching when the package moved into
# packages/color-map, which let build artifacts show up as untracked.
cjs/
dist/
esm/
lib/
out/
tslib/
